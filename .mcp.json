{
  "mcpServers": {
    "atlassian": {
      "command": "uv",
      "args": ["run", "--no-project", "${CLAUDE_PLUGIN_ROOT}/scripts/run_mcp.py"],
      "env": {
        "JIRA_URL": "${user_config.jira_url}",
        "JIRA_USERNAME": "${user_config.jira_email}",
        "JIRA_API_TOKEN": "${user_config.jira_api_token}"
      }
    }
  }
}
