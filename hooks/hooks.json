{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/bootstrap.sh"]
          },
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "${CLAUDE_PLUGIN_ROOT}/scripts/sync_credentials.py"
            ]
          }
        ]
      }
    ]
  }
}
